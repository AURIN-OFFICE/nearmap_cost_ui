# Nearmap API token — only needed for the live validation harness
# (cost_estimation/validation/run_live_validation.py).
#
# All live checks use preview=true, so NO credits are charged. The Streamlit app
# itself takes the API key from the UI, not from this file.
#
# Copy to .env and fill in your key. Do NOT commit your real .env (it is gitignored).
NEARMAP_API_TOKEN=your_api_token_here
